@echo off
setlocal EnableDelayedExpansion
title Laptop Agent Setup
color 0B

set "TOKEN=sufyandev123"
set "PORT=8900"
set "DEST=%LOCALAPPDATA%\LaptopAgent"
if not "%~1"=="" set "DEST=%~1"

echo.
echo   ===============================================
echo      LAPTOP AGENT - SETUP
echo   ===============================================
echo.
echo   Install folder : %DEST%
echo   Token          : %TOKEN%
echo.

rem ---------------------------------------------- 1. python
echo   [1/5] Python dekh rahe hain ...
set "PY="
for %%P in (python.exe) do if not defined PY set "PY=%%~$PATH:P"
if not defined PY (
    if exist "%LOCALAPPDATA%\Programs\Python\Python313\python.exe" set "PY=%LOCALAPPDATA%\Programs\Python\Python313\python.exe"
)
if not defined PY (
    echo         Python nahi mila. Install karne ki koshish kar rahe hain ...
    winget install -e --id Python.Python.3.12 --accept-source-agreements --accept-package-agreements >nul 2>&1
    if exist "%LOCALAPPDATA%\Programs\Python\Python312\python.exe" set "PY=%LOCALAPPDATA%\Programs\Python\Python312\python.exe"
)
if not defined PY (
    echo.
    echo   !! Python install nahi ho saka.
    echo      https://www.python.org/downloads/ se install karein
    echo      "Add python.exe to PATH" ka box zaroor tick karein, phir ye file dobara chalayein.
    echo.
    pause
    exit /b 1
)
echo         mil gaya: %PY%

rem ---------------------------------------------- 2. extract
echo   [2/5] Files nikaal rahe hain ...
if not exist "%DEST%" mkdir "%DEST%" >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$src = '%~f0';" ^
  "$text = [IO.File]::ReadAllText($src);" ^
  "$i = $text.LastIndexOf('#PAYLOAD_BEGIN#');" ^
  "if ($i -lt 0) { Write-Error 'payload missing'; exit 1 };" ^
  "$b64 = $text.Substring($i + 15).Trim();" ^
  "$zip = Join-Path $env:TEMP 'laptop-agent-payload.zip';" ^
  "[IO.File]::WriteAllBytes($zip, [Convert]::FromBase64String($b64));" ^
  "Expand-Archive -Path $zip -DestinationPath '%DEST%' -Force;" ^
  "Remove-Item $zip -Force"
if errorlevel 1 (
    echo   !! Files nikaalne me masla hua.
    pause
    exit /b 1
)

rem ---------------------------------------------- 3. packages
echo   [3/5] Python packages install kar rahe hain ... ^(pehli baar 1-2 minute^)
"%PY%" -m pip install --quiet --disable-pip-version-check -r "%DEST%\requirements.txt"
if errorlevel 1 (
    echo   !! pip fail hua. Internet check karein.
    pause
    exit /b 1
)

rem ---------------------------------------------- 4. shared token
echo   [4/5] Token aur settings likh rahe hain ...
if not exist "%DEST%\data" mkdir "%DEST%\data" >nul 2>&1
> "%DEST%\data\config.json" echo {
>>"%DEST%\data\config.json" echo   "port": %PORT%,
>>"%DEST%\data\config.json" echo   "token": "%TOKEN%",
>>"%DEST%\data\config.json" echo   "provider": "local",
>>"%DEST%\data\config.json" echo   "fps": 6,
>>"%DEST%\data\config.json" echo   "quality": 55,
>>"%DEST%\data\config.json" echo   "maxWidth": 1280
>>"%DEST%\data\config.json" echo }

rem the launcher must point at this machine's python
> "%DEST%\agent-start.vbs" echo ' Starts the laptop agent with no window at all.
>>"%DEST%\agent-start.vbs" echo Dim shell, fso, here, pyw, cmd
>>"%DEST%\agent-start.vbs" echo Set shell = CreateObject("WScript.Shell")
>>"%DEST%\agent-start.vbs" echo Set fso = CreateObject("Scripting.FileSystemObject")
>>"%DEST%\agent-start.vbs" echo here = fso.GetParentFolderName(WScript.ScriptFullName)
>>"%DEST%\agent-start.vbs" echo shell.CurrentDirectory = here
>>"%DEST%\agent-start.vbs" echo pyw = Replace("%PY%", "python.exe", "pythonw.exe")
>>"%DEST%\agent-start.vbs" echo If Not fso.FileExists(pyw) Then pyw = "%PY%"
>>"%DEST%\agent-start.vbs" echo If AgentIsRunning() Then WScript.Quit 0
>>"%DEST%\agent-start.vbs" echo cmd = """" ^& pyw ^& """ -m agent.main"
>>"%DEST%\agent-start.vbs" echo shell.Run cmd, 0, False
>>"%DEST%\agent-start.vbs" echo Function AgentIsRunning()
>>"%DEST%\agent-start.vbs" echo   Dim wmi, procs, p, found
>>"%DEST%\agent-start.vbs" echo   found = False
>>"%DEST%\agent-start.vbs" echo   On Error Resume Next
>>"%DEST%\agent-start.vbs" echo   Set wmi = GetObject("winmgmts:\\.\root\cimv2")
>>"%DEST%\agent-start.vbs" echo   Set procs = wmi.ExecQuery("SELECT CommandLine FROM Win32_Process WHERE Name='pythonw.exe' OR Name='python.exe'")
>>"%DEST%\agent-start.vbs" echo   For Each p In procs
>>"%DEST%\agent-start.vbs" echo     If Not IsNull(p.CommandLine) Then
>>"%DEST%\agent-start.vbs" echo       If InStr(p.CommandLine, "agent.main") ^> 0 Then found = True
>>"%DEST%\agent-start.vbs" echo     End If
>>"%DEST%\agent-start.vbs" echo   Next
>>"%DEST%\agent-start.vbs" echo   On Error GoTo 0
>>"%DEST%\agent-start.vbs" echo   AgentIsRunning = found
>>"%DEST%\agent-start.vbs" echo End Function

rem ---------------------------------------------- 5. auto start + shortcuts
echo   [5/5] Auto start aur shortcuts laga rahe hain ...
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$ws = New-Object -ComObject WScript.Shell;" ^
  "$startup = [Environment]::GetFolderPath('Startup');" ^
  "$desktop = [Environment]::GetFolderPath('Desktop');" ^
  "$l = $ws.CreateShortcut((Join-Path $startup 'Laptop Agent.lnk'));" ^
  "$l.TargetPath = 'wscript.exe';" ^
  "$l.Arguments = '\"%DEST%\agent-start.vbs\"';" ^
  "$l.WorkingDirectory = '%DEST%';" ^
  "$l.WindowStyle = 7; $l.Save();" ^
  "$on = $ws.CreateShortcut((Join-Path $desktop 'Agent ON.lnk'));" ^
  "$on.TargetPath = '%DEST%\agent-on.bat'; $on.WorkingDirectory = '%DEST%'; $on.Save();" ^
  "$off = $ws.CreateShortcut((Join-Path $desktop 'Agent OFF.lnk'));" ^
  "$off.TargetPath = '%DEST%\agent-stop.bat'; $off.WorkingDirectory = '%DEST%'; $off.Save()"

rem firewall, best effort - needs admin, skipped quietly otherwise
netsh advfirewall firewall add rule name="Laptop Agent %PORT%" dir=in action=allow protocol=TCP localport=%PORT% >nul 2>&1
netsh advfirewall firewall add rule name="Laptop Agent discovery" dir=in action=allow protocol=UDP localport=8899 >nul 2>&1

echo.
echo   Agent chalu kar rahe hain ...
start "" wscript.exe "%DEST%\agent-start.vbs"
timeout /t 6 >nul

echo.
echo   ===============================================
echo      HO GAYA
echo   ===============================================
echo.
rem no pipe here on purpose: inside a caret continued powershell -Command the
rem escaped bar leaks through as a literal caret and the query silently fails
powershell -NoProfile -Command ^
  "$all = @(Get-NetIPAddress -AddressFamily IPv4).IPAddress;" ^
  "foreach ($i in $all) { if ($i -notlike '127.*' -and $i -notlike '169.*') { Write-Host ('      http://' + $i + ':%PORT%') } }"
echo.
echo      token : %TOKEN%
echo.
echo   Phone app me sirf LAPTOP DHOONDO dabaein - IP khud bhar jayega.
echo   Ye laptop ab on hote hi khud chalu ho jayega.
echo.
echo   Desktop par Agent ON / Agent OFF ke shortcuts bhi hain.
echo.
pause
exit /b 0

#PAYLOAD_BEGIN#
